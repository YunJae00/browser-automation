# Claude Code reuses local sign-in if no API key is set. Set LLM_PROVIDER=cli to force that path.
LLM_PROVIDER=
LLM_MODEL=
# Optional Anthropic Messages API. Use a proxy base URL without /v1.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Decision Model: the same full address, key and model name as engram's decision connection.
# Without these the app runs every step on the LLM.
DECISION_BASE_URL=
DECISION_API_KEY=
DECISION_MODEL=

# The evaluated app defaults to the fixed policy. Set risk to use the learned predictor.
APP_POLICY=fixed
# Optional override for the calibrated risk threshold. Falls back to 0.5 before calibration.
RISK_THRESHOLD=

# Optional Decision Model tariff in USD per call for the experiment report.
SMALL_PRICE_CALL=
